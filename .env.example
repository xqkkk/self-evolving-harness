# Copy to .env and fill in. Keys stay on the host; task containers never receive them.

# Model providers (referenced from providers.json through "api_key_env")
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Sandboxes (Harbor's Daytona environment)
DAYTONA_API_KEY=

# Hugging Face (gated benchmark files, the GAIA2 filesystem snapshot)
HF_TOKEN=

# GAIA2 judge: an OpenAI-compatible chat endpoint (the paper used DeepSeek V4 Flash at max effort)
GAIA2_JUDGE_MODEL=
GAIA2_JUDGE_BASE_URL=
GAIA2_JUDGE_API_KEY=
GAIA2_JUDGE_REASONING_EFFORT=max
GAIA2_JUDGE_NUM_VOTES=3

# BrowseComp-Plus judge (the paper used the same model as the GAIA2 judge)
BCPLUS_JUDGE_MODEL=
BCPLUS_JUDGE_BASE_URL=
BCPLUS_JUDGE_API_KEY=
BCPLUS_JUDGE_REASONING_EFFORT=max

# Claw-Eval judges (defaults: OpenRouter; the API key falls back to OPENROUTER_API_KEY)
CLAW_JUDGE_MODEL=google/gemini-3.5-flash
CLAW_JUDGE_REASONING_EFFORT=high
CLAW_MULTITURN_JUDGE_MODEL=anthropic/claude-opus-4.6

# APEX-Agents judge (a LiteLLM model name; the API key falls back to OPENROUTER_API_KEY)
APEX_JUDGE_MODEL=openrouter/google/gemini-3.5-flash

# Host relay for tau3 and Claw-Eval sandboxes (python -m adapters.relay.host): model calls use OPENROUTER_API_KEY
# (or --base-url / --key-env); Claw-Eval web_real searches and fetches use ScraperAPI keys (SERP_DEV_KEY, SERP_DEV_KEY_2, ...)
SERP_DEV_KEY=

# Optional: append a cost receipt per model call (no prompts are logged)
HARNESS_COST_LOG=
