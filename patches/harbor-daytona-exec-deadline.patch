@@ -1657,6 +1657,32 @@ class DaytonaEnvironment(ComposeServiceOpsMixin, BaseEnvironment):
         timeout_sec: int | None = None,
         shell: str = "bash -c",
         user: str | int | None = None,
+    ) -> ExecResult:
+        # Remote GNU timeout bounds the command; independently bound session
+        # dispatch, status polling and log retrieval when the backend stalls.
+        # The grace permits remote termination/log flushing without extending
+        # the trial's externally enforced agent budget.
+        operation = self._sandbox_exec_unbounded(
+            command, cwd, env, timeout_sec, shell, user
+        )
+        if timeout_sec is None or timeout_sec <= 0:
+            return await operation
+        try:
+            return await asyncio.wait_for(operation, timeout=float(timeout_sec) + 10)
+        except TimeoutError as exc:
+            raise RuntimeError(
+                "Daytona command transport deadline exceeded after "
+                f"{timeout_sec}s plus 10s cleanup grace"
+            ) from exc
+
+    async def _sandbox_exec_unbounded(
