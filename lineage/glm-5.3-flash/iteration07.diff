+# Attached-image accounting, calibrated on round-9 trials: with base64 images
+# in the request the gateway refused at ~390-400k total request chars (while
+# text-only requests survived to ~670k) - the gateway bills image data at
+# roughly 1.7x the per-char rate of text, and 60+ refusals across 17 image
+# trials each cost a recovery round trip. So an image is priced from its real
+# serialized size, not a flat guess; a compact threshold just for image runs
+# sits well below the measured refusal line; and only a small live-image mass
+# is kept, since two or three full-size pictures alone reach the ceiling.
+IMG_CHAR_COST = 60_000        # floor per image, when the payload is tiny
+IMG_COST_FACTOR = 1.0         # images are priced at their true serialized size
+IMG_KEEP = 2                  # newest attached images kept in history
+IMG_MASS_CAP = 220_000        # max total serialized size of live images
+IMG_COMPACT_AT_CHARS = 330_000  # compaction threshold while images are live
+IMG_ACCEPT_BYTES = 78_000     # per-image attach budget in _IMAGE_SNIPPET (two of
+                             # these fit inside IMG_MASS_CAP, so batched views stay live)
 
