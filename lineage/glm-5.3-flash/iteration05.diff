+def _trim_arguments(a, keep=800):
+    """Shorten an old tool-call's argument string to a valid-JSON prefix, so a
+    gateway that parses arguments still accepts the replayed item."""
+    cut = a[:keep]
+    p = cut.rfind("}")
+    if p > 0:
+        try:
+            json.loads(cut[:p + 1])
+            return cut[:p + 1]
+        except Exception:
+            pass
+    return "{\"trimmed\": true}"
