+def _forget_large_bash_payload(message, limit=4000):
+    """Keep generated scripts on disk, not repeated in every model request."""
+    def shorten(arguments):
+        try:
+            value = json.loads(arguments)
+        except (TypeError, json.JSONDecodeError):
+            return arguments
+        command = value.get("command")
+        if isinstance(command, str) and len(command) > limit:
+            value["command"] = (
+                f"[executed {len(command):,}-character shell payload; inspect the "
+                "created files and tool output if its contents are needed]"
+            )
+            return json.dumps(value)
+        return arguments
+
+    for call in message.get("tool_calls") or []:
+        fn = call.get("function") or {}
+        if fn.get("name") == "bash":
+            fn["arguments"] = shorten(fn.get("arguments"))
+    # Responses API clients replay these raw items instead of tool_calls.
+    for item in message.get("_responses_items") or []:
+        if item.get("type") == "function_call" and item.get("name") == "bash":
+            item["arguments"] = shorten(item.get("arguments"))
 
 
