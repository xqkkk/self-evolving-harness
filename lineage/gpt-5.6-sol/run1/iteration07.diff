+def _ends_turn_tool(item):
+    """Honor tool metadata that declares a successful call ends this agent turn."""
+    text = item.get("description", "").lower()
+    matches = re.finditer(
+        r"\b(?:will\s+)?(?:end|ends|finish|finishes|terminate|terminates)\s+"
+        r"(?:the\s+)?(?:agent(?:['’]s)?\s+)?turn\b", text
+    )
+    return any("not" not in text[max(0, m.start() - 16):m.start()].split() for m in matches)
 
 
