+_DUMPS = itertools.count(1)
+_DUMP_CHUNK = 60_000      # one exec per chunk; base64 of it stays under argv limits
+_DUMP_CAP = 450_000       # beyond this the tail of a wall of text is not worth its transfer
+
+
+async def keep(text, limit, world, stats):
+    """Clip one result, but never lose it: the whole text goes to a file.
+
+    What the window cannot hold is skipped in the middle, and the fact the
+    task needs is as often there as at either end. A re-run can fetch a
+    command's output again, but a tool the task publishes returns the same
+    wall of text every time, so the harness keeps its own copy beside the
+    task file and the clipped view names the path: the skipped middle becomes
+    a `grep` instead of a guess. The copy is base64 through the shell, so no
+    quoting, marker or newline in the text can corrupt it.
+    """
+    text = text or ""
+    if len(text) <= limit:
+        return text
+    path = f"/tmp/.harness_out_{next(_DUMPS)}.txt"
+    body = text[:_DUMP_CAP].encode()
+    try:
+        for i in range(0, len(body), _DUMP_CHUNK):
+            await world.exec(
+                f"printf %s {base64.b64encode(body[i:i + _DUMP_CHUNK]).decode()} "
+                f"| base64 -d {'>>' if i else '>'} {path}", timeout_s=60)
+        stats["kept_files"] = stats.get("kept_files", 0) + 1
+        kept = ""                     # set when the copy had to be shortened
+        if len(text) > _DUMP_CAP:
+            kept = f" (first {_DUMP_CAP} of {len(text)} characters kept)"
+    except Exception:
+        return clip(text, limit)          # the window still gets its clipped view
+    return clip(text, limit) + (
+        f"\n[harness] the full output{kept} is at {path} — read the part you "
+        "need from there (`grep`, `sed -n`, `tail`) rather than re-calling the "
+        "tool or re-running the command.")
 
 
