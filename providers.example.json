    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "model": "openai/gpt-5.6-sol",
    "reasoning_effort": "high",
    "max_output_tokens": 65536,
    "max_input_tokens": 258400,
    "extra_body": {"provider": {"sort": "price"}}
  },
